#!/usr/bin/env bash
# Local-only updater. No push, upstream merge or data/secret rewrites.
set -euo pipefail
umask 077
MODE=update
if [[ ${1:-} == --check ]]; then MODE=check; shift; fi
REF=${1:?usage: caya-update [--check] <local-ref>}
[[ $# == 1 && $REF != -* ]] || { echo 'One non-option local ref required' >&2; exit 2; }
APP=${CAYA_UPDATE_APP:-/opt/bot-panel/app}
STATE=${CAYA_UPDATE_STATE:-/var/lib/bot-panel}
USER_NAME=${CAYA_UPDATE_USER:-caya}
NODE_DIR=${CAYA_UPDATE_NODE:-/opt/node22/bin}
UNIT=${CAYA_UPDATE_UNIT:-caya.service}
HOOKS=${CAYA_UPDATE_HOOKS:-/opt/bot-panel/hooks}
UNIT_FILE=${CAYA_UPDATE_UNIT_FILE:-/etc/systemd/system/$UNIT}
SECRET_DIR=${CAYA_UPDATE_SECRET_DIR:-/etc/example-server}
export PATH="$NODE_DIR:$PATH"
[[ $MODE == check || $(id -u) == 0 ]] || { echo 'Run as root' >&2; exit 2; }
exec 9>"$STATE/caya-update.lock"
flock -n 9 || { echo 'Another update is running' >&2; exit 2; }
as_caya() { (cd "$APP" && if [[ $(id -un) == "$USER_NAME" ]]; then env PATH="$PATH" "$@"; else runuser -u "$USER_NAME" -- env PATH="$PATH" "$@"; fi); }
git_caya() { as_caya git -C "$APP" "$@"; }
[[ -z $(git_caya status --porcelain) ]] || { echo 'Working tree is dirty; commit or preserve changes first' >&2; exit 2; }
# Refuse owner/permission problems while the current service is still running.
for output in "$APP/server/dist" "$APP/web/dist"; do
  if [[ -d "$output" ]]; then
    blocked=$(as_caya find "$output" ! -writable -print -quit)
    [[ -z "$blocked" ]] || { echo "Build output not writable by $USER_NAME: $blocked; build as the service account" >&2; exit 2; }
  fi
done
if [[ -d "$APP/node_modules" ]]; then
  blocked=$(as_caya find "$APP/node_modules" -type d ! -writable -print -quit)
  [[ -z "$blocked" ]] || { echo "Dependency directory not writable by $USER_NAME: $blocked" >&2; exit 2; }
fi
SOURCE_PREVIOUS=$(git_caya rev-parse HEAD)
PREVIOUS=$SOURCE_PREVIOUS
if [[ -f "$STATE/deployed-revision" ]]; then
  PREVIOUS=$(git_caya rev-parse --verify --end-of-options "$(cat "$STATE/deployed-revision")^{commit}")
fi
BRANCH=$(git_caya symbolic-ref --quiet --short HEAD) || { echo 'Use a local development branch, not detached HEAD' >&2; exit 2; }
CANDIDATE=$(git_caya rev-parse --verify --end-of-options "$REF^{commit}")
git_caya merge-base --is-ancestor "$SOURCE_PREVIOUS" "$CANDIDATE" || { echo 'Ref would discard local patch history; merge/rebase and review locally first' >&2; exit 2; }
printf 'Local candidate %s on %s (previous %s)\n' "$CANDIDATE" "$BRANCH" "$PREVIOUS"
[[ $MODE == check ]] && exit 0
BACKUP_DIR="$STATE/backups/updates"
install -d -m 700 -o root -g root "$BACKUP_DIR"
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
BACKUP="$BACKUP_DIR/caya-before-$STAMP.tar.gz"
BUNDLE="$BACKUP_DIR/caya-source-$STAMP.bundle"
NATIVE_CACHE_EXISTED=false
[[ -d "$APP/.native-deps" ]] && NATIVE_CACHE_EXISTED=true
WAS_ACTIVE=false
systemctl is-active --quiet "$UNIT" && WAS_ACTIVE=true
stopped=false
rollback() {
  local result=$?
  trap - EXIT INT TERM
  if (( result == 0 )); then return; fi
  rm -f -- "$STATE/.deployed-revision.next"
  echo "Update failed; restoring source $PREVIOUS. Persistent state was not overwritten. Backup: $BACKUP" >&2
  if $stopped; then
    systemctl stop "$UNIT" || true
    if git_caya checkout --quiet "$PREVIOUS" && build; then
      # A legacy ref has no .native-deps ignore rule. Preserve only a cache
      # created by this update outside the tree so the next update stays usable.
      if ! $NATIVE_CACHE_EXISTED && [[ -d "$APP/.native-deps" ]] &&
          ! git_caya cat-file -e "$SOURCE_PREVIOUS:vendor/native/sources.json" 2>/dev/null; then
        mv -- "$APP/.native-deps" "$BACKUP_DIR/native-deps-$STAMP"
      fi
      git_caya update-ref "refs/caya/update-failed/$STAMP" "$CANDIDATE"
      git_caya update-ref "refs/heads/$BRANCH" "$SOURCE_PREVIOUS" "$CANDIDATE"
      git_caya switch --quiet "$BRANCH"
      if $WAS_ACTIVE; then systemctl start "$UNIT"; health || echo 'Rollback service health failed; inspect logs' >&2; fi
    else
      echo 'Rollback build failed; service remains stopped. Restore the source/build from the recorded revision.' >&2
    fi
  fi
  exit "$result"
}
build() {
  (cd "$APP" &&
    { if [[ -f vendor/native/sources.json ]]; then as_caya npm run prepare:native-deps; fi; } &&
    as_caya npm ci --include=dev --no-audit --no-fund && as_caya npm run test:unit && as_caya npm run typecheck && as_caya npm run build)
}
health() {
  local bind port
  bind=$(systemctl show "$UNIT" -p Environment --value | python3 -c 'import shlex,sys;print(dict(x.split("=",1) for x in shlex.split(sys.stdin.read()) if "=" in x).get("CAYA_HOST","127.0.0.1"))')
  port=$(systemctl show "$UNIT" -p Environment --value | python3 -c 'import shlex,sys;print(dict(x.split("=",1) for x in shlex.split(sys.stdin.read()) if "=" in x).get("CAYA_PORT","3001"))')
  for _ in {1..30}; do
    if systemctl is-active --quiet "$UNIT" && curl -fsS "http://$bind:$port/api/state" >/dev/null; then return 0; fi
    sleep 1
  done
  return 1
}
trap rollback EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
systemctl stop "$UNIT"
stopped=true
# With CaYa stopped, capture consistent data plus protected credentials/config.
MEMBERS=("${STATE#/}/data" "${STATE#/}/secrets" "${HOOKS#/}" "${UNIT_FILE#/}")
[[ -f "$STATE/deployed-revision" ]] && MEMBERS+=("${STATE#/}/deployed-revision")
[[ -d "$UNIT_FILE.d" ]] && MEMBERS+=("${UNIT_FILE#/}.d")
shopt -s nullglob
for secret in "$SECRET_DIR"/caya-bot-*.pass; do MEMBERS+=("${secret#/}"); done
shopt -u nullglob
git_caya bundle create - --all > "$BUNDLE"
git -c safe.directory="$APP" -C "$APP" bundle verify "$BUNDLE" >/dev/null 2>&1
tar --exclude='*/data/logs' -czf "$BACKUP" -C / "${MEMBERS[@]}"
tar -tzf "$BACKUP" >/dev/null
sha256sum "$BACKUP" "$BUNDLE" > "$BACKUP.sha256"
printf 'previous=%s\nsource_previous=%s\ncandidate=%s\nbranch=%s\n' "$PREVIOUS" "$SOURCE_PREVIOUS" "$CANDIDATE" "$BRANCH" > "$BACKUP.revision"
# Branch remains our maintained local branch; never automatically merge upstream.
git_caya merge --ff-only "$CANDIDATE"
build
if $WAS_ACTIVE; then systemctl start "$UNIT"; health; fi
printf '%s\n' "$CANDIDATE" > "$STATE/.deployed-revision.next"
mv "$STATE/.deployed-revision.next" "$STATE/deployed-revision"
trap - EXIT INT TERM
printf 'Updated locally to %s; backup %s\n' "$CANDIDATE" "$BACKUP"
